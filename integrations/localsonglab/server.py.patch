+                  or re.fullmatch(r"/api/reaper/projects/[0-9a-f-]{36}/revisions/[0-9a-f-]{36}/listen", path))
+    if model_work and not _runtime_enabled:
+        raise AppError("The music business is stopped. Start it before requesting new work.", 409)
 
 
