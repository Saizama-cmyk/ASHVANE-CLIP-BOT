+def set_runtime(payload):
+    global _runtime_enabled, _active_job
+    if not isinstance(payload, dict) or set(payload) != {"enabled"} or type(payload["enabled"]) is not bool:
+        raise AppError("Choose whether the music business is enabled.")
+    enabled = payload["enabled"]
+    with _runtime_lock, _create_lock:
+        _runtime_enabled = enabled
+        reaper_pipeline._save(_runtime_state_path, {"enabled": enabled})
+        reaper_pipeline.set_enabled(enabled)
+        if enabled:
+            try:
+                launch.ensure_studio()
+            except (OSError, RuntimeError) as error:
+                raise AppError("Music was enabled but YuE2 Studio could not start. Check its retained launcher log.", 503) from error
+        else:
+            if _active_job:
+                try:
+                    studio("song_job_cancel", {"job_id": _active_job})
+                except AppError:
+                    print("Music stop: owned generation cancellation could not reach Studio", flush=True)
+                _active_job = None
+            for pipeline in (voice_pipeline, training_pipeline):
+                if pipeline:
+                    for ident in list(pipeline._JOBS):
+                        pipeline.cancel_job(ident)
+            for reference in reference_pipeline.list_references():
+                if reference.get("status") in ("queued", "running", "analyzing"):
+                    reference_pipeline.cancel(reference["id"])
+            if rap_assistant and (rap_assistant.any_busy() or reaper_pipeline.any_gpu_busy()):
+                try:
+                    rap_assistant._rpc("assistant_stop", timeout=5)
+                except (OSError, ValueError, RuntimeError):
+                    print("Music stop: local assistant did not confirm unloading", flush=True)
+            try:
+                launch.stop_owned_studio()
+            except (OSError, RuntimeError):
+                print("Music stop: the owned Studio process could not be stopped", flush=True)
+    return runtime_status()
+
+
