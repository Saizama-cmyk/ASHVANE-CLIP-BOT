+def runtime_status():
+    ready = launch.studio_running() if _runtime_enabled else False
+    return {"enabled": _runtime_enabled, "ready": ready, "message": "Music service ready." if ready else "Music service starting; saved media remain readable." if _runtime_enabled else "Music service stopped; saved media and the normal REAPER editor remain available."}
