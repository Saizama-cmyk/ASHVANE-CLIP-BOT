{
  "expo": {
    "name": "Ashvane",
    "slug": "ashvane",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-ios.png",
    "scheme": "ashvane",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070D",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070D"
    },
    "ios": {
      "bundleIdentifier": "app.ashvane.mobile",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "10.0.0.0/8": { "NSExceptionAllowsInsecureHTTPLoads": true },
            "172.16.0.0/12": { "NSExceptionAllowsInsecureHTTPLoads": true },
            "192.168.0.0/16": { "NSExceptionAllowsInsecureHTTPLoads": true },
            "100.64.0.0/10": { "NSExceptionAllowsInsecureHTTPLoads": true }
          }
        },
        "NSLocalNetworkUsageDescription": "Ashvane talks to the Ashvane app running on your PC over your local network.",
        "UIBackgroundModes": []
      },
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true
      },
      "icon": "./assets/icon-ios.png"
    },
    "android": {
      "package": "app.ashvane.mobile",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-adaptive.png",
        "backgroundColor": "#05070D"
      },
      "icon": "./assets/icon-ios.png",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock with Face ID so nobody else can open your desk or your chats."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos and videos to a message for the assistant.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-font"
    ],
    "notification": {
      "icon": "./assets/icon-notification.png",
      "color": "#05070D"
    },
    "web": {
      "favicon": "./assets/icon-ios.png"
    }
  }
}
